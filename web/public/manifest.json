{
  "name": "music-share",
  "short_name": "music-share",
  "description": "Record tab audio, organize songs into playlists, and share listening links.",
  "start_url": "/",
  "display": "standalone",
  "orientation": "any",
  "min_viewport_width": 320,
  "background_color": "#ffffff",
  "theme_color": "#111111",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "permissions": [
    {
      "name": "screen",
      "reason": "Captures the audio of a browser tab you choose to record"
    },
    {
      "name": "clipboard",
      "reason": "Copies playlist share links"
    }
  ]
}
